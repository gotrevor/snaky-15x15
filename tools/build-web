#!/usr/bin/env -S uv run --quiet python3
"""Assemble the static site into build/web/: the files in web/ plus the card set as cards.txt
(and Sieben's 17 x 17 card set as cards-17x17.txt).
The result is plain static files (no server code); upload the directory anywhere, e.g.
`wrangler pages deploy build/web --project-name snaky`.  For snaky.gotrevor.org use tools/deploy-web,
which refuses to deploy anything but a clean origin/main.

The 9 x 9 page (9x9.html) reads a snapshot of the search from 9x9/: progress.json plus one
certificate per proved first move.  The search runs elsewhere and its exporter writes that
directory; pass it with --nine.  Without it the page says no snapshot is published.

Every script, stylesheet and module import is referenced as NAME?v=<sha256 prefix of its built
content>: the host caches .js and .css for hours but revalidates the HTML, so a stale script
alongside a fresh page (the phone saw the new 9 x 9 page run the old script) cannot happen.

usage: tools/build-web [OUT_DIR] [--nine SNAPSHOT_DIR]      (default OUT_DIR build/web)
"""
import argparse
import hashlib
import json
import os
import re
import shutil

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FILES = ["index.html", "style.css", "app.js", "engine.js", "9x9.html", "nine-app.js", "nine.js", "17x17.html"]
# Versioned in this order, so a module's stamp covers the stamps of what it imports.
ASSETS = ["style.css", "engine.js", "nine.js", "app.js", "nine-app.js"]
REF = re.compile(r"""(["'])(\./)?([\w.-]+\.(?:js|css))\1""")


def stamp(text, versions):
    """Rewrite references to known assets as NAME?v=HASH."""
    def sub(m):
        q, dot, name = m.group(1), m.group(2) or "", m.group(3)
        return f"{q}{dot}{name}?v={versions[name]}{q}" if name in versions else m.group(0)
    return REF.sub(sub, text)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("out", nargs="?", default=os.path.join(HERE, "build", "web"))
    ap.add_argument("--nine", help="9 x 9 snapshot directory (progress.json + cert-*.txt)")
    args = ap.parse_args()
    out = args.out
    os.makedirs(out, exist_ok=True)
    versions = {}
    for f in ASSETS + [f for f in FILES if f not in ASSETS]:
        text = stamp(open(os.path.join(HERE, "web", f), encoding="utf-8").read(), versions)
        if f in ASSETS:
            versions[f] = hashlib.sha256(text.encode()).hexdigest()[:10]
        with open(os.path.join(out, f), "w", encoding="utf-8") as fh:
            fh.write(text)
    shutil.copyfile(os.path.join(HERE, "cert", "snaky-15x15-cards.txt"), os.path.join(out, "cards.txt"))
    # 17x17.html: Sieben's 20-move proof sequence as cards (third_party/sieben/README.md).
    shutil.copyfile(os.path.join(HERE, "third_party", "sieben", "cards-17x17.txt"), os.path.join(out, "cards-17x17.txt"))
    wrote = FILES + ["cards.txt", "cards-17x17.txt"]
    if args.nine:
        snap = json.load(open(os.path.join(args.nine, "progress.json")))
        dest = os.path.join(out, "9x9")
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        os.makedirs(dest)
        names = ["progress.json"] + [m[k] for m in snap["moves"] for k in ("cert", "report") if m.get(k)]
        for name in names:
            shutil.copyfile(os.path.join(args.nine, name), os.path.join(dest, name))
        wrote.append(f"9x9/ ({len(names)} files)")
    print(f"wrote {out}: {', '.join(wrote)}")


if __name__ == "__main__":
    main()
