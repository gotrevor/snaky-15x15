#!/usr/bin/env -S uv run --quiet python3
"""Assemble the static site into build/web/: the files in web/ plus the card set as cards.txt.
The result is plain static files (no server code); upload the directory anywhere, e.g.
`wrangler pages deploy build/web --project-name snaky`.

The 9 x 9 page (9x9.html) reads a snapshot of the search from 9x9/: progress.json plus one
certificate per proved first move.  The search runs elsewhere and its exporter writes that
directory; pass it with --nine.  Without it the page says no snapshot is published.

usage: tools/build-web [OUT_DIR] [--nine SNAPSHOT_DIR]      (default OUT_DIR build/web)
"""
import argparse
import json
import os
import shutil

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FILES = ["index.html", "style.css", "app.js", "engine.js", "9x9.html", "nine-app.js", "nine.js"]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("out", nargs="?", default=os.path.join(HERE, "build", "web"))
    ap.add_argument("--nine", help="9 x 9 snapshot directory (progress.json + cert-*.txt)")
    args = ap.parse_args()
    out = args.out
    os.makedirs(out, exist_ok=True)
    for f in FILES:
        shutil.copyfile(os.path.join(HERE, "web", f), os.path.join(out, f))
    shutil.copyfile(os.path.join(HERE, "cert", "snaky-15x15-cards.txt"), os.path.join(out, "cards.txt"))
    wrote = FILES + ["cards.txt"]
    if args.nine:
        snap = json.load(open(os.path.join(args.nine, "progress.json")))
        dest = os.path.join(out, "9x9")
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        os.makedirs(dest)
        names = ["progress.json"] + [m["cert"] for m in snap["moves"] if m.get("cert")]
        for name in names:
            shutil.copyfile(os.path.join(args.nine, name), os.path.join(dest, name))
        wrote.append(f"9x9/ ({len(names)} files)")
    print(f"wrote {out}: {', '.join(wrote)}")


if __name__ == "__main__":
    main()
